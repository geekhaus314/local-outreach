{
  "name": "local-outreach-clinic-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name clinic-engine",
    "db:migrate:local": "wrangler d1 migrations apply local-outreach --local",
    "db:migrate:remote": "wrangler d1 migrations apply local-outreach --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "^2.21.4",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^26.4.1",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.31",
    "svelte": "^5.33.14",
    "svelte-check": "^4.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.126.0"
  }
}
