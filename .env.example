# Google Places API (New) key. Without this the scraper falls back to free
# OpenStreetMap data, which has thin coverage of US local businesses.
# 1. https://console.cloud.google.com/ -> create project
# 2. Enable "Places API (New)"
# 3. Create an API key and restrict it to that API
# Google gives new projects a monthly credit that is plenty for local prospecting.
GOOGLE_PLACES_API_KEY=

# Shown in the User-Agent so public endpoints can contact you instead of
# silently blocking you. Use a real address if you have one.
SCRAPER_USER_AGENT=local-outreach-scraper/1.0 (+mailto:you@example.com)

# Optional: real contact address, used when you ask the scraper to look up
# review text for evidence you can quote in outreach.
OUTREACH_EMAIL=

# Optional: only used by `export_to_crm.py` after you select and confirm one
# CSV row. The private pwn4g3 admin API also requires your source IP to be
# allowlisted. Never commit the real token; keep it in `.env` or the shell.
PWN4G3_ADMIN_TOKEN=

# --- tuning -----------------------------------------------------------------
SCRAPER_TIMEOUT=20
AUDIT_TIMEOUT=12
SCRAPER_RETRIES=4
SCRAPER_CACHE_TTL_HOURS=24
SCRAPER_USE_CACHE=1
AUDIT_ENABLED=1
AUDIT_CONCURRENCY=6
SCRAPER_VERBOSE=0

# Places API quota guardrails. pageSize is capped at 20 and maxPages at 3 by
# Google, so MAX_QUERIES is the real lever on spend.
PLACES_MAX_PAGES=3
MAX_QUERIES=0

# Comma-separated Overpass mirrors, tried in order.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
