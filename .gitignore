# Build output from sites/build-all.mjs and sites/build-standalone.mjs. Fully
# reproducible from source with `node sites/build-all.mjs`, and it contains two
# separate deployables, so committing it would just mean two copies of the same
# page drifting apart in review.
dist/
.venv/
venv/
.env
.DS_Store

